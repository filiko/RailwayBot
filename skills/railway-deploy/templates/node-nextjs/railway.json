{
  "$schema": "https://railway.app/railway.schema.json",
  "service": {
    "name": "nextjs-app",
    "language": "node"
  },
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build",
    "installCommand": "npm install"
  },
  "deploy": {
    "startCommand": "npm start",
    "healthcheckPath": "/",
    "healthcheckPort": 3000,
    "restartPolicy": "on-failure",
    "restartLimitMs": 30000
  },
  "environment": {
    "NODE_ENV": "production"
  }
}
